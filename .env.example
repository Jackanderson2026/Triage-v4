# BigQuery — read-only service account scoped to sessions-core-data.
# Single base64-encoded JSON blob (Vercel-friendly), not a file path.
# Decoder lives at lib/bq/client.ts.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Project + datasets used by lib/bq/queries/*. Datasets in sessions-core-data:
#   production, analytics, serve, hubspot, marketing, deliveroo
GCP_PROJECT_ID=sessions-core-data

# NextAuth — Google Workspace SSO, hd-restricted to sessions.co.uk.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres for annotations. Use Neon serverless connection string.
DATABASE_URL=

# Optional — daily BQ bytes-billed soft cap (defaults to working ceiling derived from §15 #6: £200/month).
BQ_DAILY_BYTES_CEILING=

# Anthropic API — powers the AI summary on partner expand. Server-side only.
# When unset, the summary section degrades gracefully (no crash, just no bullets).
ANTHROPIC_API_KEY=
